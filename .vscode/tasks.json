{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "SASS Watch - Compilación Automática",
      "type": "shell",
      "command": "npm",
      "args": ["run", "sass"],
      "isBackground": true,
      "problemMatcher": {
        "pattern": {
          "regexp": "^Error: (.*)$",
          "file": 1,
          "location": 1,
          "message": 2
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^.*Watching for changes.*$",
          "endsPattern": "^.*Error:.*$"
        }
      },
      "runOptions": {
        "runOn": "folderOpen"
      },
      "presentation": {
        "echo": true,
        "reveal": "silent",
        "focus": false,
        "panel": "shared",
        "showReuseMessage": false
      }
    }
  ]
}
